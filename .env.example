# Optional initial password (at least 12 characters); only used on first boot.
# If empty, a random password is printed once in container logs.
AMBERGATE_ADMIN_PASSWORD=
# true only when the admin panel is accessed through your HTTPS proxy.
AMBERGATE_SECURE_COOKIE=false
# Optional compose.docker.yaml overlay: path on the Docker host.
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Usually detected automatically. Set if the gateway has a custom hostname.
AMBERGATE_DOCKER_CONTAINER=
# Exact IPs/CIDRs of HTTPS proxies reaching the admin listener, comma-separated.
# Empty = ignore forwarded client IPs. Never list client networks or 0.0.0.0/0.
AMBERGATE_ADMIN_TRUSTED_PROXIES=
# Central gateway: persistent tunnel targets per agent (1..512); existing targets survive.
AMBERGATE_AGENT_TARGET_LIMIT=128
